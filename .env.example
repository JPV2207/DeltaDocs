# ==============================================================================
# AutoDocs - Environment Variables Configuration
# Copy this file to .env and customize values according to your environment.
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=3001
DOCS_WEB_PORT=3000
API_BASE_URL=http://localhost:3001
DOCS_WEB_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# PostgreSQL Database & Prisma
# ------------------------------------------------------------------------------
# In Docker: postgres://postgres:postgres@postgres:5432/autodocs?schema=public
# Locally:   postgresql://postgres:postgres@localhost:5432/autodocs?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/autodocs?schema=public

# ------------------------------------------------------------------------------
# Redis & BullMQ Queue
# ------------------------------------------------------------------------------
# In Docker: redis://redis:6379
# Locally:   redis://localhost:6379
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# GitHub Integration (GitHub App Authentication)
# Preferred for production. Follow README.md for instructions to create a GitHub App.
# ------------------------------------------------------------------------------
GITHUB_APP_ID=123456
# Paste your RSA private key (either multiline with \n or escaped)
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEowIBAAKCAQEA...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=your_super_secret_webhook_token_here
GITHUB_APP_INSTALLATION_ID=98765432

# (Optional fallback) GitHub Personal Access Token (classic with repo scope or fine-grained)
# If set, this can be used for local testing when you haven't registered a GitHub App yet.
GITHUB_PAT=

# Target repository & branch to watch
DEFAULT_REPOSITORY=owner/repository-name
DEFAULT_BRANCH=main

# ------------------------------------------------------------------------------
# LLM Providers (Vercel AI SDK)
# ------------------------------------------------------------------------------
# Primary Provider: Anthropic Claude 3.5 Sonnet
ANTHROPIC_API_KEY=sk-ant-api03-xxx
PRIMARY_MODEL=claude-3-5-sonnet-20241022

# Free Provider Option: Google Gemini (100% Free at https://aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Fallback Provider: DeepSeek (Optional, used if Anthropic is unavailable)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Fallback Provider: Ollama Local Models (Optional, e.g. http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# LLM provider to use: "gemini" | "anthropic" | "deepseek" | "ollama" | "mock"
# Set to "mock" for $0 and 0 API keys (uses built-in smart generator)
LLM_PROVIDER=mock

# ------------------------------------------------------------------------------
# Queue & Worker Settings
# ------------------------------------------------------------------------------
QUEUE_CONCURRENCY=2
QUEUE_MAX_RETRIES=3
QUEUE_BACKOFF_DELAY_MS=5000

# ------------------------------------------------------------------------------
# Security & Rate Limiting
# ------------------------------------------------------------------------------
THROTTLE_TTL=60
THROTTLE_LIMIT=100
ADMIN_API_KEY=autodocs-admin-secret-key-change-in-prod
