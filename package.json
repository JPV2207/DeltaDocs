{
  "name": "autodocs",
  "version": "1.0.0",
  "private": true,
  "description": "Production-grade automated documentation system with git commit versioning",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "build:shared": "npm run build -w packages/shared",
    "build:api": "npm run build -w apps/api",
    "build:web": "npm run build -w apps/docs-web",
    "dev:api": "npm run start:dev -w apps/api",
    "dev:web": "npm run dev -w apps/docs-web",
    "prisma:generate": "npm run prisma:generate -w apps/api",
    "prisma:migrate": "npm run prisma:migrate -w apps/api",
    "lint": "npm run lint --workspaces"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
